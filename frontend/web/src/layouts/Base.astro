---
import "@/styles/global.css";

interface Props {
  title?: string;
}

const { title = "Carwash" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Anti-flash: aplica la clase `dark` antes del primer paint.
      // El valor lo gestiona useThemeStore (localStorage `carwash.theme`).
      (function () {
        try {
          var s = localStorage.getItem("carwash.theme");
          var sysDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var dark = s === "dark" || ((s === null || s === "system") && sysDark);
          if (dark) document.documentElement.classList.add("dark");
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg-app text-text-primary antialiased">
    <slot />
  </body>
</html>
