# Plantilla de variables. Copiala a .env y completa los valores.
# El archivo .env NO se comitea (esta en .gitignore).
#
# Para dev local con docker compose alcanza con SECRET_KEY.
# Para prod hay que setear todas estas, ademas de CORS_ALLOW_ORIGIN_REGEX.

# --- Database (dentro del compose) ---
POSTGRES_USER=carwash
POSTGRES_PASSWORD=cambiar-esta-password
POSTGRES_DB=carwash

# --- Database (override directo si corres sin compose) ---
# DATABASE_URL=postgresql+psycopg://user:pass@host:port/db
# PGHOST=localhost
# PGPORT=5433
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=carwash

# --- Auth / JWT ---
# Generala con: openssl rand -hex 32
AUTH_TOKEN_SECRET=
AUTH_TOKEN_EXPIRES_MINUTES=60

# --- CORS ---
# Default (no setear) permite localhost. En prod, regex de tus dominios:
# CORS_ALLOW_ORIGIN_REGEX=https://[a-z0-9-]+\.carwash\.mukusoft\.com

# --- Frontend ---
# Puerto del host donde se publica el frontend en dev. En prod, NPM toma
# el container desde la red 'proxy' y este puerto deja de importar.
FRONTEND_PORT=80
